{
  "name": "relasi-crm",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered CRM for small businesses and agencies.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
