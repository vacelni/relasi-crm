# Supabase (Project Settings → API). Only the publishable key goes to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public URL of this deployment (invitation links, email and payment callbacks).
SITE_URL=http://localhost:3000

# Server-only. Used by the payment webhook to mark orders paid; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional. Without it, the AI features fall back to built-in heuristics.
ANTHROPIC_API_KEY=

# Optional. Midtrans sandbox keys (dashboard.sandbox.midtrans.com → Settings → Access keys).
# Without them, the billing page explains how to enable payments.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Shows "Try the demo" buttons on the login page (the demo accounts exist in the database).
NEXT_PUBLIC_DEMO_ENABLED=true
